+    # Graded fitness gate (Tier-2 adaptation for continuous metrics). Runs LAST:
+    # it is the only gate that re-executes the harness over the probe set, so a
+    # candidate that already failed a cheap gate must never pay for it. Short-
+    # circuits ok when the recipe wired no fitness context, which is what keeps
+    # the stock binary benchmarks (GAIA/tau2/tb2) behaving exactly as before.
+    if canonical.ok and counterfactual.ok and replay.ok:
+        fv = await check_fitness_noregress(candidate_config_path)
+        fitness = GateVerdict(fv.ok, fv.reason)
+    else:
+        fitness = GateVerdict(False, _SKIP)
+
     return {
         "structure": structure,
         "novelty": novelty,
         "canonicalize": canonical,
         "counterfactual": counterfactual,
         "replay": replay,
+        "fitness": fitness,
