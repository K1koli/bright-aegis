+def _resolve_shell() -> str | None:
+    """Shell used by shell-mode commands.
+
+    subprocess defaults to cmd.exe on Windows, which cannot run the POSIX syntax
+    the AEGIS templates assume (`cat > f`, heredocs, `&&` chains with quoted
+    args). Set HARNESSX_BASH to a real bash (e.g. Git for Windows) or have it on
+    PATH to restore POSIX semantics; otherwise the platform default is used.
+    """
+    return os.environ.get("HARNESSX_BASH") or shutil.which("bash")
+
 
 
