new file mode 100644
index 0000000..698f428
--- /dev/null
+++ b/harnessx/aegis/budget.py
@@ -0,0 +1,37 @@
+# Copyright 2026 Darwin-Agent
+# SPDX-License-Identifier: MIT
+"""Per-stage cost ceilings for the AEGIS meta-agents.
+
+Every meta stage (Digester / Planner / Evolver / Critic) runs with a
+``CostGuardProcessor`` whose ceiling was hard-coded to $100 in the orchestrator
+and in Stage P. That is a reasonable default for a frontier-model pilot, but it
+puts no effective brake on a stage that decides to iterate: in the BRIGHT pilot
+the Evolver alone ran 63 steps and spent $16.32, and the round totalled ~$27.5.
+
+This module makes the ceiling one env-var-controlled value so a driver can bound
+a whole run without patching the engine:
+
+    AEGIS_MAX_STAGE_COST_USD=6.0
+
+Note ``AegisAgent.budget_per_round_usd`` is NOT this knob: it is accepted and
+threaded through the public API but never read, so it enforces nothing. This is
+the ceiling the CostGuardProcessor actually enforces.
+"""
+from __future__ import annotations
+
+import os
+
+DEFAULT_STAGE_COST_USD = 100.0
+
+ENV_VAR = "AEGIS_MAX_STAGE_COST_USD"
+
+
+def max_stage_cost_usd() -> float:
+    """Cost ceiling for a single meta stage, from ``AEGIS_MAX_STAGE_COST_USD``."""
+    raw = os.environ.get(ENV_VAR)
+    if raw is None or not str(raw).strip():
+        return DEFAULT_STAGE_COST_USD
+    try:
+        return float(raw)
+    except (TypeError, ValueError):
+        return DEFAULT_STAGE_COST_USD
