+      - econ R1 C-R1-03 was the ONLY candidate that run's Critic ever selected. It was
+        rejected for listing ``_verify_deep_snippets.py`` under
+        bucket=['config','prompt']; the run then went no-op/no-op and hit patience at
+        round 2 with zero ships, so the domain was never actually measured.
+      - rob R8 C-R8-01 was rejected the same way for ``verify_c_r8_01.py``.
+
+    Both were correct candidates killed by a packaging detail unrelated to whether
+    the harness works.
+    """
+    name = Path(path).name
+    if not name.lower().endswith(".py"):
+        return False
+    return bool(_SCRATCH_PY_RE.match(Path(name).stem))
+
