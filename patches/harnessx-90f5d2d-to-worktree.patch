index 0000000..cc38d88
--- /dev/null
+++ b/harnessx/aegis/gates/fitness.py
@@ -0,0 +1,138 @@
+# Copyright 2026 Darwin-Agent
+# SPDX-License-Identifier: MIT
+"""Graded no-regression gate — Tier-2 adaptation for continuous fitness.
+
+The stock AEGIS gates reason over **binary** per-task flags. The only in-gate
+regression check, :mod:`harnessx.aegis.gates.counterfactual`, protects
+previously-passing tasks by exact string equality of ``final_output`` /
+``exit_reason``, which cannot see a task sliding from 0.62 to 0.21 while still
+"passing" a threshold. For benchmarks scored with a graded metric (BRIGHT's
+nDCG@10) that blind spot is the difference between a harness that generalises
+and one that trades one query for another.
+
+This gate re-evaluates the candidate harness on a **frozen probe set** and
+requires both:
+
+    mean_fitness(candidate) >= mean_fitness(incumbent) + margin      (aggregate)
+    fitness_q(candidate)    >= fitness_q(incumbent)   - delta    for every q
+
+``margin`` and ``delta`` are registered a priori and never adjusted per round;
+the probe set is fixed for the whole run so scores stay comparable across
+rounds. Both are read from the fitness context, which the recipe drives via
+``AegisAgent(fitness_context=...)``.
+
+Cost: one harness evaluation per probe query per candidate that reaches this
+gate. It is therefore placed **last** in the gate order, behind the cheap
+structural gates and the replay smoke test, so a candidate that cannot ship for
+a structural reason never pays for it.
+"""
+from __future__ import annotations
+
+import inspect
+from pathlib import Path
+from typing import Any
+
+from .structure import GateResult
+
+__all__ = ["set_fitness_context", "get_fitness_context", "check_fitness_noregress"]
+
+# Module-level context, mirroring ``set_counterfactual_context`` in
+# ``harnessx.aegis.stages.commit``. Orchestrator populates it before calling
+# run_stage_4. Keys:
+#   probe_qids       : list[str]           frozen probe query ids
+#   incumbent_scores : dict[str, float]    incumbent harness's per-query fitness
+#   fitness_fn       : Callable[[Path, list[str]], Awaitable|dict]
+#                                          evaluates a candidate config YAML
+#   delta            : float               per-query regression tolerance
+#   margin           : float               aggregate improvement requirement
+# None → gate short-circuits ok (so benchmarks without graded fitness keep the
+# stock behaviour).
+_FITNESS_CONTEXT: dict | None = None
+
+
+def set_fitness_context(ctx: dict | None) -> None:
+    global _FITNESS_CONTEXT
+    _FITNESS_CONTEXT = ctx
+
+
+def get_fitness_context() -> dict | None:
+    return _FITNESS_CONTEXT
+
+
+async def _maybe_await(value: Any) -> Any:
+    if inspect.isawaitable(value):
+        return await value
+    return value
+
+
+def _mean(values: list[float]) -> float:
+    return sum(values) / len(values) if values else 0.0
+
+
+async def check_fitness_noregress(
+    candidate_config_path: str | Path,
+    *,
+    context: dict | None = None,
+) -> GateResult:
+    ctx = context if context is not None else _FITNESS_CONTEXT
+    if ctx is None:
+        return GateResult(True, "skipped: no fitness context wired")
+
+    qids = [str(q) for q in (ctx.get("probe_qids") or [])]
+    incumbent = {str(k): float(v) for k, v in (ctx.get("incumbent_scores") or {}).items()}
+    fitness_fn = ctx.get("fitness_fn")
+    if not qids:
+        return GateResult(True, "skipped: no probe queries wired")
+    if fitness_fn is None:
+        return GateResult(True, "skipped: no fitness_fn wired")
+    if not incumbent:
+        return GateResult(True, "skipped: incumbent scores unavailable")
+
+    delta = float(ctx.get("delta", 0.05))
+    margin = float(ctx.get("margin", 0.0))
+
+    try:
+        scores = await _maybe_await(fitness_fn(Path(candidate_config_path), qids))
+    except Exception as exc:  # noqa: BLE001
+        return GateResult(False, f"fitness: candidate evaluation failed: {exc!r}")
+    if not isinstance(scores, dict):
+        return GateResult(False, f"fitness: fitness_fn returned {type(scores).__name__}, expected dict")
+
+    missing = [q for q in qids if q not in scores]
+    if missing:
+        return GateResult(
+            False,
+            f"fitness: no score for {len(missing)}/{len(qids)} probe queries "
+            f"(e.g. {missing[0]}) — a candidate that cannot run the probe set cannot ship",
+        )
+
+    cand_scores = {q: float(scores[q]) for q in qids}
+    shared = [q for q in qids if q in incumbent]
+    if not shared:
+        return GateResult(True, "skipped: no probe query has an incumbent score")
+
+    mean_cand = _mean([cand_scores[q] for q in shared])
+    mean_inc = _mean([incumbent[q] for q in shared])
+
+    if mean_cand + 1e-12 < mean_inc + margin:
+        return GateResult(
+            False,
+            f"fitness: aggregate regression — candidate {mean_cand:.4f} < "
+            f"incumbent {mean_inc:.4f} + margin {margin:g} (n={len(shared)})",
+        )
+
+    regressed = [q for q in shared if cand_scores[q] < incumbent[q] - delta]
+    if regressed:
+        worst = min(regressed, key=lambda q: cand_scores[q] - incumbent[q])
+        return GateResult(
+            False,
+            f"fitness: {len(regressed)}/{len(shared)} probe queries regressed beyond "
+            f"delta={delta:g} (worst {worst}: {incumbent[worst]:.4f} -> {cand_scores[worst]:.4f}); "
+            f"aggregate {mean_inc:.4f} -> {mean_cand:.4f}",
+        )
+
+    return GateResult(
+        True,
+        f"fitness ok: {mean_inc:.4f} -> {mean_cand:.4f} "
+        f"(delta={delta:g}, margin={margin:g}, n={len(shared)})",
+    )
