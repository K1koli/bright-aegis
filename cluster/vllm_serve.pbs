#!/bin/bash
#PBS -N vllm-qwen35
#PBS -q gpu_ded
# Project/budget. `gs_ccds_wei.lu` ended on 2026-10-17 and qsub now fails with
#     Budgets: queuejob: : Project has already ended.
# `qstat -B -f` lists the live budgets: the same PI still has
#     ds_ccds_wei.lu  (max_run_res.ngpus = 16)
#     fs_ccds_wei.lu  (max_run_res.ngpus = 1)
# `ds_` is the dedicated-GPU budget that pairs with the gpu_ded queue; fall back to
# fs_ccds_wei.lu (1 GPU, enough for tensor-parallel-size 1) if ds_ is refused.
#PBS -P ds_ccds_wei.lu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
# 168h = 7 days. The previous 72h was set while the *biology* run was in flight and it
# expired exactly 72h later, killing the server mid-project. A single evolution run is
# 14-19h and the transfer matrix needs several of them, so the server must outlive the
# whole experimental campaign, not one run.
#
# If qsub rejects this walltime the queue caps it -- check with
#     ssh gaas "qstat -Q -f gpu_ded | grep -i walltime"
# and use the largest value it allows.
#PBS -l walltime=168:00:00
#PBS -j oe
#PBS -o /home/n2602358e/logs/vllm-qwen35.log

# PBS spools a job's stdout and only writes it when the job ENDS -- useless for a
# service that never ends. Redirect the shell itself so progress is visible live.
LOG=/home/n2602358e/logs/vllm-qwen35.out
exec > "$LOG" 2>&1

echo "=== host / date ==="
hostname
date

echo "=== CUDA-related env from PBS ==="
env | grep -i -E "cuda|nvidia" | sort
echo "CUDA_VISIBLE_DEVICES=[$CUDA_VISIBLE_DEVICES]"

echo "=== nvidia-smi as PBS exposes it ==="
nvidia-smi -L

cd "$HOME"
module load vllm/0.19.0

echo "=== vllm version ==="
python -c "import vllm; print(vllm.__version__)" 2>&1

# PBS hands out GPUs as UUIDs (CUDA_VISIBLE_DEVICES=GPU-<uuid>). This vLLM build
# does int(CUDA_VISIBLE_DEVICES) and dies. Translate the UUID to its true physical
# index by enumerating with CUDA_VISIBLE_DEVICES unset -- we must NOT just set it
# to 0, because index 0 in the filtered view is not necessarily the physical GPU
# PBS granted us, and other jobs share this node.
if [ -n "$CUDA_VISIBLE_DEVICES" ]; then
  NEW=""
  OLDIFS=$IFS
  IFS=','
  for d in $CUDA_VISIBLE_DEVICES; do
    case "$d" in
      GPU-*)
        idx=$(env -u CUDA_VISIBLE_DEVICES nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null | awk -F', *' -v u="$d" '$2==u {print $1; exit}')
        [ -z "$idx" ] && idx=0
        echo "mapped $d -> physical index $idx"
        ;;
      *)
        idx="$d"
        ;;
    esac
    if [ -z "$NEW" ]; then NEW="$idx"; else NEW="$NEW,$idx"; fi
  done
  IFS=$OLDIFS
  export CUDA_VISIBLE_DEVICES="$NEW"
  echo "CUDA_VISIBLE_DEVICES rewritten to [$CUDA_VISIBLE_DEVICES]"
fi

echo "=== tool-call-parser choices reported by this vLLM ==="
vllm serve --help 2>&1 | grep -i -A 6 "tool-call-parser" | head -24

echo "=== launching vllm serve ==="
# Tool parser: this model emits Qwen3's XML tool-call dialect
#   <tool_call><function=NAME><parameter=K>V</parameter></function></tool_call>
# `hermes` expects JSON inside <tool_call> and silently leaves tool_calls EMPTY,
# which would make every BRIGHT query score 0. `qwen3_xml` (registered name from
# vllm/tool_parsers/__init__.py) is the parser that matches this dialect.
#
# Reasoning parser: splits the model's  thinking...<｜end▁of▁thinking｜> trace into
# `reasoning_content`, leaving `content` clean. The tool call is emitted AFTER
# </think>, so it is not swallowed by the thinking block.
exec vllm serve /home/n2602358e/models/Qwen3.5-9B \
  --served-model-name Qwen3.5-9B \
  --host 0.0.0.0 \
  --port 8000 \
  --tensor-parallel-size 1 \
  --gpu-memory-utilization 0.90 \
  --max-model-len 32768 \
  --enable-auto-tool-choice \
  --tool-call-parser qwen3_xml \
  --reasoning-parser qwen3
