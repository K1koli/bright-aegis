# Copy to .env.local and fill in. .env.local is never committed.
#
#   cp .env.example .env.local
#
# Two roles, deliberately different models (HarnessX's AEGIS separates them):
#   * TASK agent   -- Qwen3.5-9B served by your OpenAI-compatible vLLM endpoint.
#                     Frozen for the whole experiment.
#   * PROPOSER     -- DeepSeek-V4-Flash, drives Digester/Planner/Evolver/Critic.

# ---- Task agent: Qwen3.5-9B (local/remote vLLM) ----------------------------
# base_url must include the /v1 suffix if your server expects it.
BRIGHT_TASK_BASE_URL=http://your-vllm-host:8000/v1
BRIGHT_TASK_MODEL=Qwen3.5-9B
# vLLM usually ignores the key; leave the placeholder if it is not checked.
BRIGHT_TASK_API_KEY=EMPTY

# ---- Proposer: DeepSeek-V4-Flash (API) ------------------------------------
BRIGHT_PROPOSER_BASE_URL=https://api.deepseek.com/v1
BRIGHT_PROPOSER_MODEL=deepseek-v4-flash
BRIGHT_PROPOSER_API_KEY=sk-REPLACE_WITH_YOUR_OWN_KEY

# ---- Optional overrides ---------------------------------------------------
# BRIGHT_TASK_TEMPERATURE=0
# BRIGHT_TASK_MAX_TOKENS=2048
